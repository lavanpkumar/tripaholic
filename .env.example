# MongoDB Atlas. Leave MONGODB_URI empty to use the local JSON file store (.data/db.json, or DATA_DIR).
MONGODB_URI=
MONGODB_DB=triphub

# Google Gemini. Leave GEMINI_API_KEY empty to run the offline (deterministic) planner + agent.
GEMINI_API_KEY=
# Current stable Flash model per https://ai.google.dev/gemini-api/docs/models (checked 2026-11-14)
GEMINI_MODEL=gemini-3.8-flash
# Set to "true" to enable Google Search grounding in the itinerary planner.
GEMINI_GROUNDING=false

NEXT_PUBLIC_APP_URL=http://localhost:3000
# mock | real (real is reserved for a future provider adapter).
# Keep comments on their own lines: systemd's EnvironmentFile treats inline "# ..." as part of the value.
PROVIDER_MODE=mock

# Optional, only for stretch real provider:
FLIGHT_API_KEY=
FLIGHT_API_SECRET=
